#!/usr/bin/env bash

# Build the site and publish it to a GitHub Pages branch.

set -Eeuo pipefail

SRC_BRANCH="master"
DEPLOY_BRANCH="gh-pages"
NO_PUSH=false

USAGE_MSG="usage: deploy [-h|--help] [-u|--user] [-s|--src SRC_BRANCH] [-d|--deploy DEPLOY_BRANCH] [--verbose] [--no-push]"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            echo "$USAGE_MSG"
            exit 0
            ;;
        -u|--user)
            # Kept for backwards compatibility. User pages use the defaults.
            ;;
        -s|--src)
            [[ $# -ge 2 ]] || { echo "Missing value for $1." >&2; exit 1; }
            SRC_BRANCH="$2"
            shift
            ;;
        -d|--deploy)
            [[ $# -ge 2 ]] || { echo "Missing value for $1." >&2; exit 1; }
            DEPLOY_BRANCH="$2"
            shift
            ;;
        --verbose)
            set -x
            ;;
        --no-push)
            NO_PUSH=true
            ;;
        *)
            echo "Option $1 is unknown." >&2
            echo "$USAGE_MSG" >&2
            exit 1
            ;;
    esac
    shift
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "Deploying..."
echo "Source branch: $SRC_BRANCH"
echo "Deploy branch: $DEPLOY_BRANCH"

read -r -p "Do you want to proceed? [y/N] " response
if [[ ! "$response" =~ ^([yY][eE][sS]|[yY])$ ]]; then
    echo "Aborting."
    exit 1
fi

if [[ -n "$(git status --porcelain --untracked-files=all)" ]]; then
    echo "The working tree contains uncommitted or untracked files:"
    git status --short
    echo "Please commit or stash them before proceeding."
    echo "Aborting."
    exit 1
fi

if ! git show-ref --verify --quiet "refs/heads/$SRC_BRANCH"; then
    echo "Source branch '$SRC_BRANCH' does not exist locally." >&2
    exit 1
fi

git switch "$SRC_BRANCH"

export JEKYLL_ENV=production
bundle exec jekyll build --lsi

TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/jekyll-deploy.XXXXXX")"
DEPLOY_DIR="$TEMP_DIR/site"
WORKTREE_ADDED=false

cleanup() {
    if [[ "$WORKTREE_ADDED" == true ]]; then
        git worktree remove --force "$DEPLOY_DIR" >/dev/null 2>&1 || true
    fi
    rm -rf "$TEMP_DIR"
}
trap cleanup EXIT

# Base the local deployment branch on its remote counterpart when available.
# This also repairs stale local branches left behind by older versions of this
# script without touching the source checkout.
if git show-ref --verify --quiet "refs/remotes/origin/$DEPLOY_BRANCH"; then
    git worktree add --force -B "$DEPLOY_BRANCH" "$DEPLOY_DIR" "origin/$DEPLOY_BRANCH"
elif git show-ref --verify --quiet "refs/heads/$DEPLOY_BRANCH"; then
    git worktree add "$DEPLOY_DIR" "$DEPLOY_BRANCH"
else
    git worktree add -b "$DEPLOY_BRANCH" "$DEPLOY_DIR" "$SRC_BRANCH"
fi
WORKTREE_ADDED=true

# Replace only the contents of the isolated deployment worktree.
git -C "$DEPLOY_DIR" rm -rf --ignore-unmatch .
git -C "$DEPLOY_DIR" clean -fdx
rsync -a "$REPO_ROOT/_site/" "$DEPLOY_DIR/"
touch "$DEPLOY_DIR/.nojekyll"

git -C "$DEPLOY_DIR" add -fA
git -C "$DEPLOY_DIR" commit --allow-empty \
    -m "$(git log -1 --pretty=%s "$SRC_BRANCH") [ci skip]"

if [[ "$NO_PUSH" == false ]]; then
    git -C "$DEPLOY_DIR" push --force --quiet origin \
        "$DEPLOY_BRANCH:$DEPLOY_BRANCH"
else
    echo "Skipping push (--no-push)."
fi

echo "Deployed successfully!"
